// source: https://learn.microsoft.com/en-us/azure/azure-monitor/reference/tables/windowsevent — fetched 2026-09-02
.create table WindowsEvent (
    _BilledSize:real,
    Channel:string,
    Computer:string,
    Correlation:string,
    EventData:dynamic,
    EventID:int,
    EventLevel:int,
    EventLevelName:string,
    EventOriginId:string,
    EventRecordId:string,
    _IsBillable:string,
    Keywords:string,
    ManagementGroupName:string,
    Opcode:string,
    Provider:string,
    RawEventData:string,
    _ResourceId:string,
    _SubscriptionId:string,
    SystemProcessId:int,
    SystemThreadId:int,
    SystemUserId:string,
    Task:int,
    TenantId:string,
    TimeGenerated:datetime,
    Type:string,
    Version:int
)
