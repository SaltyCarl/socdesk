{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["generated_at", "schema_version", "attribution", "ips"],
  "properties": {
    "generated_at": {"type": "string"},
    "schema_version": {"type": "integer"},
    "attribution": {"type": "string", "maxLength": 500},
    "count": {"type": "integer", "minimum": 0},
    "total_before_cap": {"type": "integer", "minimum": 0},
    "cap": {"type": "integer", "minimum": 0},
    "truncated": {"type": "boolean"},
    "dropped_no_geo": {"type": "integer", "minimum": 0},
    "ips": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ip", "country", "lat", "lng", "source", "malware",
                     "port", "first_seen", "last_seen", "geo_precision"],
        "properties": {
          "ip": {"type": "string", "minLength": 3, "maxLength": 45},
          "country": {"type": "string", "minLength": 2, "maxLength": 2},
          "lat": {"type": "number", "minimum": -90, "maximum": 90},
          "lng": {"type": "number", "minimum": -180, "maximum": 180},
          "source": {"enum": ["feodotracker", "threatfox"]},
          "malware": {"type": ["string", "null"], "maxLength": 96},
          "port": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
          "first_seen": {"type": "string", "maxLength": 40},
          "last_seen": {"type": "string", "maxLength": 40},
          "geo_precision": {"enum": ["city", "country"]}
        }
      }
    }
  }
}
