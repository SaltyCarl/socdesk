{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["generated_at", "schema_version", "items"],
  "properties": {
    "generated_at": {"type": "string"},
    "schema_version": {"type": "integer"},
    "items": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "category", "title", "summary", "url",
                     "severity", "entities", "iocs", "published_at", "collected_at"],
        "properties": {
          "id": {"type": "string", "minLength": 40, "maxLength": 40},
          "source": {"type": "string", "maxLength": 32},
          "category": {"enum": ["ransomware", "vulnerability", "malware",
                                 "apt", "campaign", "report"]},
          "title": {"type": "string", "minLength": 1, "maxLength": 300},
          "summary": {"type": "string", "maxLength": 500},
          "url": {"type": "string", "maxLength": 512},
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "entities": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actors", "malware", "vendors", "cves"],
            "properties": {
              "actors": {"$ref": "#/$defs/names"},
              "malware": {"$ref": "#/$defs/names"},
              "vendors": {"$ref": "#/$defs/names"},
              "cves": {"$ref": "#/$defs/names"}
            }
          },
          "iocs": {"type": "array", "maxItems": 64, "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": {
              "type": {"enum": ["ipv4", "domain", "url", "md5", "sha256"]},
              "value": {"type": "string", "maxLength": 512}
            }
          }},
          "published_at": {"type": "string", "maxLength": 40},
          "collected_at": {"type": "string", "maxLength": 40},
          "score": {"type": "integer", "minimum": 0, "maximum": 100},
          "grouped": {"type": "integer"},
          "why": {"type": "array", "maxItems": 6,
                  "items": {"type": "string", "maxLength": 80}},
          "victim": {"type": "string", "maxLength": 200},
          "domain": {"type": "string", "maxLength": 253}
        }
      }
    }
  },
  "$defs": {
    "names": {"type": "array", "maxItems": 64,
              "items": {"type": "string", "maxLength": 96}}
  }
}
