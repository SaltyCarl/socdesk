{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["generated_at", "schema_version", "groups"],
  "additionalProperties": false,
  "properties": {
    "generated_at": {"type": "string", "maxLength": 40},
    "schema_version": {"type": "integer"},
    "cve_context": {
      "type": "object",
      "maxProperties": 512,
      "propertyNames": {"pattern": "^CVE-[0-9]{4}-[0-9]{4,7}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kev": {"type": "boolean"},
          "kev_ransomware": {"type": "boolean"},
          "epss": {"type": "number", "minimum": 0, "maximum": 1},
          "cvss": {"type": "number", "minimum": 0, "maximum": 10},
          "kev_due_date": {"type": "string", "maxLength": 10}
        }
      }
    },
    "groups": {"type": "array", "maxItems": 500, "items": {
      "type": "object",
      "required": ["slug", "name"],
      "additionalProperties": false,
      "properties": {
        "slug": {"type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z0-9 ._-]+$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 64},
        "aliases": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 64}},
        "first_seen": {"type": "string", "maxLength": 10},
        "raas": {"type": "boolean"},
        "initial_access_cves": {"type": "array", "maxItems": 32,
          "items": {"type": "string", "pattern": "^CVE-\\d{4}-\\d{4,7}$"}},
        "advisory": {"type": "object", "required": ["id", "url"],
          "properties": {
            "id": {"type": "string", "maxLength": 32},
            "url": {"type": "string", "maxLength": 256, "pattern": "^https://([a-z0-9-]+\\.)*(cisa|hhs)\\.gov/"}
          }},
        "tools": {"type": "array", "maxItems": 40, "items": {"type": "string", "maxLength": 64}},
        "ransom_note": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 128}},
        "extensions": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 32}},
        "advisory_date": {"type": "string", "maxLength": 10},
        "last_reviewed": {"type": "string", "maxLength": 10},
        "note_image": {"type": "string", "maxLength": 256, "pattern": "^https://([a-z0-9-]+\\.)*(cisa|hhs)\\.gov/"},
        "sources": {"type": "array", "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "url"],
          "properties": {
            "id": {"type": "string", "maxLength": 32},
            "url": {"type": "string", "maxLength": 256}
          }
        }}
      }
    }}
  }
}
