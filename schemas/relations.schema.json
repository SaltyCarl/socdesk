{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["generated_at", "schema_version", "nodes", "edges"],
  "properties": {
    "generated_at": {"type": "string"},
    "schema_version": {"type": "integer"},
    "nodes": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "name", "degree"],
        "properties": {
          "id": {"type": "string", "maxLength": 110},
          "type": {"enum": ["actor", "malware", "vendor", "cve",
                            "technique", "product"]},
          "name": {"type": "string", "minLength": 1, "maxLength": 96},
          "degree": {"type": "integer", "minimum": 1},
          "kev": {"type": "boolean"}
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 60000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "src", "dst", "weight", "evidence"],
        "properties": {
          "type": {"enum": ["uses_technique", "uses_software", "cooccurs",
                            "affects_vendor", "affects_product"]},
          "src": {"type": "string", "maxLength": 110},
          "dst": {"type": "string", "maxLength": 110},
          "weight": {"type": "integer", "minimum": 1},
          "evidence": {"type": "array", "minItems": 1, "maxItems": 8,
                       "items": {"type": "string", "maxLength": 40}}
        }
      }
    }
  }
}
