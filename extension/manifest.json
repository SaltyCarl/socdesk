{
  "manifest_version": 3,
  "name": "SOCDesk — Indicator Lookup",
  "version": "0.3.0",
  "description": "Right-click or paste an IP, domain, URL or file hash to get a live multi-source reputation verdict from your SOCDesk instance.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://socdesk.io/*",
    "https://socdesk.pages.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SOCDesk — Indicator Lookup",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
